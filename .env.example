# SES Complaint Report — example config. Copy to .env and edit.
SESREPORT_PROFILE=default
SESREPORT_REGION=us-east-1
SESREPORT_EXTRA_REGIONS=us-west-2

# CloudWatch Logs feedback pipeline. Leave SESREPORT_LOG_GROUPS blank to
# auto-discover groups under the prefix that contain the match string.
# SESREPORT_LOG_GROUPS=/aws/lambda/my-api-feedback
SESREPORT_LOG_GROUP_PREFIX=/aws/lambda/
SESREPORT_LOG_GROUP_MATCH=

# Application stores. Leave blank to skip the per-recipient sections; the
# demo model (SESREPORT_DEMO=1) shows them with synthetic data.
SESREPORT_COMPLAINT_TABLE=
SESREPORT_COMPLAINT_ATTR=bounce_type
SESREPORT_COMPLAINT_VALUE=Complaint
SESREPORT_COMPLAINT_QUEUE=
SESREPORT_SUPPRESSION_TABLES=

# Mask recipient addresses in the API payload (recommended if you screenshot it).
SESREPORT_REDACT_EMAILS=false

# Serve a bundled synthetic dataset instead of querying AWS.
SESREPORT_DEMO=false

SESREPORT_HOST=127.0.0.1
SESREPORT_PORT=8787
SESREPORT_REFRESH_SECONDS=3600
