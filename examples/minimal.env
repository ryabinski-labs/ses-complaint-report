# Minimal real-account audit: SES posture + CloudWatch complaint metrics.
# Deliberately leaves every application-store variable blank, so the
# per-recipient sections render empty while the rest of the report works.
SESREPORT_PROFILE=default
SESREPORT_REGION=us-east-1

# Optional: summarise sending identities in additional regions.
# SESREPORT_EXTRA_REGIONS=us-west-2

# No per-recipient stores wired up:
SESREPORT_COMPLAINT_TABLE=
SESREPORT_COMPLAINT_QUEUE=
SESREPORT_SUPPRESSION_TABLES=

# Recommended when screenshotting or sharing the report:
# SESREPORT_REDACT_EMAILS=true
